{
  "name": "fontvault",
  "version": "0.2.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/app.tsx --bundle --outdir=dist --entry-names=app --loader:.module.css=local-css --jsx=automatic",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "node --test \"tests/*.test.*\""
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@fluentui/react-icons": "^2.0.344",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "description": "Gestor de fuentes e iconos para diseñadores",
  "author": "jdsgnrinfo",
  "build": {
    "appId": "com.jdsgnr.fontvault",
    "productName": "FontVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "gdi.js",
      "icons.js",
      "index.html",
      "dist/**",
      "package.json",
      "build/icon.png",
      "build/tray-white.png",
      "build/tray-black.png",
      "providers.js",
      "font-names.js"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "FontVault-Setup-${version}.exe",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FontVault",
      "runAfterFinish": true
    }
  },
  "license": "MIT"
}
